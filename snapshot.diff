+  margin-bottom: 10px;
+}
+
+.sidebar-resize {
+  position: absolute;
+  top: 0;
+  right: -4px;
+  bottom: 0;
+  width: 8px;
+  cursor: ew-resize;
+  z-index: 4;
+  touch-action: none;
+  outline: none;
+}
+
+.sidebar-resize::after {
+  content: '';
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  left: 3px;
+  width: 1px;
+  background: transparent;
+}
+
+.sidebar-resize:hover::after,
+.sidebar-resize:focus-visible::after {
+  background: #718378;
+}
+
+body.sidebar-resizing,
+body.sidebar-resizing * {
+  cursor: ew-resize !important;
+  user-select: none !important;
+}
+
+.sidebar-frame.collapsed .sidebar-resize {
+  display: none;
+}
+
+.sidebar-toggle {
+  position: absolute;
+  top: 14px;
+  right: -13px;
+  z-index: 5;
+  width: 26px;
+  height: 30px;
+  padding: 0;
+  display: grid;
+  place-items: center;
+  border-radius: 0 6px 6px 0;
+  font-size: 17px;
+  line-height: 1;
+  box-shadow: 0 4px 16px #0004;
+}
+
+.sidebar-frame.collapsed .sidebar-toggle {
+  border-radius: 0 6px 6px 0;
+}
+
+.campaign-home {
+  min-height: calc(100dvh - 78px);
+  padding: 56px max(28px, calc((100vw - 1120px) / 2));
+  background: radial-gradient(circle at 80% 10%, #344b3655, transparent 38%);
+}
+
+.campaign-home-head {
+  display: flex;
+  align-items: end;
+  justify-content: space-between;
+  gap: 24px;
+  margin-bottom: 36px;
+}
+
+.campaign-home-head-actions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.campaign-home h1 { margin: 8px 0; font-size: 40px; }
+.campaign-home-head p { color: var(--muted); margin: 0; }
+.campaign-home-head button { width: auto; }
+.scene-cards { display: grid; grid-template-columns: repeat(auto-fill,minmax(250px,1fr)); gap: 18px; }
+.scene-card { min-height: 190px; padding: 22px; border: 1px solid #415048; border-radius: 9px; background: linear-gradient(145deg,#24302e,#192123); display: flex; flex-direction: column; gap: 14px; }
+.scene-card.gm-only { border-style: dashed; background: #181f21; }
+.scene-card h2 { margin: 0; font: 24px/1.25 Georgia,serif; overflow-wrap: anywhere; }
+.scene-status { color: var(--accent); font-size: 10px; letter-spacing: 1.2px; text-transform: uppercase; }
+.scene-card.gm-only .scene-status { color: #a79a83; }
+.scene-card > .primary { margin-top: auto; }
+.scene-card-controls { display: grid; grid-template-columns: 1fr 1fr auto; gap: 6px; }
+.scene-card-controls button { padding: 7px; font-size: 10px; }
+.empty-scenes { padding: 70px 20px; text-align: center; color: var(--muted); border: 1px dashed var(--border); border-radius: 9px; }
+.empty-scenes > span { font-size: 46px; }
+.saved-campaign { display: grid; grid-template-columns: 1fr auto; gap: 8px; margin-bottom: 12px; }
+#resumeList .saved-campaign button { width: auto; margin: 0; }
