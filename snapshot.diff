+func TestCircularTransitionTriggersOnEntryAndDoesNotBounce(t *testing.T) {
+	scene := newScene("scene", "Scene")
+	lower := firstFloorID(scene)
+	upper := "upper-transition"
+	scene.Floors[upper] = Floor{ID: upper, Name: "Этаж 2", Order: 1, Opacity: 1}
+	addFloorLayers(scene, upper)
+	transition := Transition{ID: "stairs", EndpointA: TransitionEndpoint{FloorID: lower, Position: ScenePoint{X: 100, Y: 100}, Radius: 32}, EndpointB: TransitionEndpoint{FloorID: upper, Position: ScenePoint{X: 200, Y: 200}, Radius: 24}, Direction: "bidirectional"}
+	if !validTransition(scene, transition) {
+		t.Fatal("valid circular transition was rejected")
+	}
+	scene.Transitions[transition.ID] = transition
+	token := Token{ID: "hero", FloorID: lower, X: 20, Y: 20}
+	if _, ok := transitionForTokenMove(scene, token, ScenePoint{X: 100, Y: 100}); !ok {
+		t.Fatal("entering endpoint did not trigger transition")
+	}
+	token.FloorID, token.X, token.Y = upper, 200, 200
+	if _, ok := transitionForTokenMove(scene, token, ScenePoint{X: 200, Y: 200}); ok {
+		t.Fatal("teleported token bounced immediately")
+	}
+	if _, ok := transitionForTokenMove(scene, token, ScenePoint{X: 160, Y: 200}); ok {
+		t.Fatal("leaving destination endpoint triggered transition")
+	}
+	token.X = 160
+	if _, ok := transitionForTokenMove(scene, token, ScenePoint{X: 200, Y: 200}); !ok {
+		t.Fatal("bidirectional destination endpoint did not trigger on re-entry")
+	}
+}
