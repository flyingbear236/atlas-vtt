+		{Type: "subtractWalkableRect", Client: "persist-walkable", Seq: 3, SceneID: sceneID, FloorID: floorID, ExpectedGeometryRevision: &revision2, WalkableBounds: &WalkableBounds{X: 20, Y: 20, Width: 20, Height: 20}},
