+.tree-layer-tokens > .tree-layer-row { color: #d1c58e; }
+.tree-layer-walkable > .tree-layer-row { color: #73bda4; }
+.tree-element-row { margin-left: 18px; color: #89998f; }
+.tree-element-row.selected { background: #34433a; color: var(--text); }
+.tree-action { border: 0; background: transparent; padding: 2px 3px; min-width: 18px; color: #93a198; font-size: 10px; }
+.tree-action:hover { background: #46534f; }
+.scene-layer-actions { display: grid; gap: 6px; }
+#elementProperties { padding-top: 12px; }
+#elementProperties input[type=range] { padding: 0; }
+
