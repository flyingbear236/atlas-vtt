+  border-color: transparent;
+  color: #9caaa3;
+  font-size: 11px;
+}
+
+.scene-tab:hover {
+  border-color: var(--border);
+}
+
+.scene-tab.active {
+  color: var(--text);
+  background: #283332;
+  border-color: #46534f;
+}
+
+.sidebar-frame {
+  --sidebar-width: 250px;
+  position: relative;
+  width: var(--sidebar-width);
+  flex: 0 0 var(--sidebar-width);
+  min-width: 0;
+  z-index: 3;
+}
+
+.sidebar-frame.collapsed {
+  width: 0;
+  flex-basis: 0;
+}
+
+.sidebar-frame.collapsed .sidebar {
+  display: none;
+}
+
