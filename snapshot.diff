+  constructor(maxCount,maxBytes){this.maxCount=maxCount;this.maxBytes=maxBytes;this.count=0;this.bytes=0;}
+  acquire(size){
+    if(size<0||this.count>=this.maxCount||this.bytes+size>this.maxBytes)return null;
