+func TestOwnedTokenLocatorUpdatesOutsideLoadedRegion(t *testing.T) {
+	server := testServer(t, t.TempDir())
+	host := httptest.NewServer(server.routes())
+	defer host.Close()
+	gm := post(t, host.URL+"/api/sessions", map[string]string{"name": "Owned locators"})
+	player := post(t, host.URL+"/api/join", map[string]string{"session": gm["session"], "invite": gm["invite"], "name": "Player"})
+
+	server.mu.Lock()
+	session := server.sessions[gm["session"]]
+	member := session.Members[session.Keys[player["key"]]]
+	scene := firstScene(session)
+	lowerFloor := firstFloorID(scene)
+	upperFloor := id()
+	scene.Floors[upperFloor] = Floor{ID: upperFloor, Name: "Upper", Order: 1, Opacity: 1}
+	addFloorLayers(scene, upperFloor)
+	session.Assets["not-for-navigation"] = Asset{ID: "not-for-navigation", Width: 64, Height: 64, Kind: "token", RenderMode: "bitmap"}
+	lower := Token{ID: "remote-owned", Name: "Remote", Owner: member.ID, FloorID: lowerFloor, LayerID: layerIDByKind(scene, lowerFloor, layerKindTokens), X: 100, Y: 100, Size: 80, Asset: "not-for-navigation"}
+	upper := Token{ID: "active-owned", Name: "Active", Owner: member.ID, FloorID: upperFloor, LayerID: layerIDByKind(scene, upperFloor, layerKindTokens), X: 8000, Y: 8000, Size: 80}
+	scene.Tokens[lower.ID], scene.Tokens[upper.ID] = lower, upper
+	scene.Revision++
+	scene.rebuildRuntime()
+	server.mu.Unlock()
+
+	playerWS := dialRaw(t, host.URL, player)
+	read(t, playerWS, "campaignSnapshot")
+	playerWS.WriteJSON(Command{Type: "subscribe", SceneID: scene.ID, ActiveTokenID: upper.ID})
+	read(t, playerWS, "snapshot")
+	region := SceneRegion{Left: 7500, Top: 7500, Right: 8500, Bottom: 8500}
+	playerWS.WriteJSON(Command{Type: "view", SceneID: scene.ID, Region: &region})
+	read(t, playerWS, "snapshot")
+
+	gmWS := dial(t, host.URL, gm)
+	read(t, gmWS, "snapshot")
+	hidden := true
+	gmWS.WriteJSON(Command{Type: "properties", SceneID: scene.ID, Token: Token{ID: lower.ID}, Properties: Properties{Hidden: &hidden}})
+	read(t, gmWS, "upsert")
+	deleted := read(t, playerWS, "ownedTokenDelete")
+	var deletedID string
+	json.Unmarshal(deleted["id"], &deletedID)
+	if deletedID != lower.ID {
+		t.Fatalf("wrong owned locator deleted: %s", deletedID)
+	}
+
+	hidden = false
+	gmWS.WriteJSON(Command{Type: "properties", SceneID: scene.ID, Token: Token{ID: lower.ID}, Properties: Properties{Hidden: &hidden}})
+	read(t, gmWS, "upsert")
+	upsert := read(t, playerWS, "ownedTokenUpsert")
+	var locator Token
+	json.Unmarshal(upsert["token"], &locator)
+	if locator.ID != lower.ID || locator.Asset != "" {
+		t.Fatalf("unsafe or wrong owned locator: %+v", locator)
+	}
+}
diff --git a/scripts/install-vips.ps1 b/scripts/install-vips.ps1
new file mode 100644
index 0000000..62ddc15
--- /dev/null
+++ b/scripts/install-vips.ps1
@@ -0,0 +1,25 @@
+$ErrorActionPreference = 'Stop'
+$project = Split-Path $PSScriptRoot -Parent
+$deps = Join-Path $project '.deps'
+$version = '8.18.6'
+$package = 'vips-dev-x64-web-8.18.6.zip'
+$expected = '10086f2ccc8e2a861831facabab75fa1b80b4bd03f0a8447623ec581002aa4b2'
+$archive = Join-Path $deps $package
+$destination = Join-Path $deps "libvips-$version"
+$binary = Join-Path $destination 'vips-dev-8.18/bin/vips.exe'
+if (![Environment]::Is64BitOperatingSystem -or $env:PROCESSOR_ARCHITECTURE -eq 'ARM64') {
+    throw 'This pinned package is for Windows x64. Install the official package for your platform and set ATLAS_VIPS.'
+}
+New-Item -ItemType Directory -Force $deps | Out-Null
+if (!(Test-Path -LiteralPath $archive)) {
+    Invoke-WebRequest -UseBasicParsing "https://github.com/libvips/build-win64-mxe/releases/download/v$version/$package" -OutFile $archive
+}
+if ((Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash -ne $expected) {
+    throw 'SHA-256 mismatch. The archive was not extracted.'
+}
+if (!(Test-Path -LiteralPath $binary)) {
+    Expand-Archive -LiteralPath $archive -DestinationPath $destination -Force
+}
+& $binary --version
+if ($LASTEXITCODE) { throw 'libvips did not start' }
+Write-Output "Atlas will use $binary"
