+package main
+
+import (
+	"bytes"
+	"image"
+	"image/color"
+	"image/png"
+	"testing"
+)
+
+// Overlapping, near-square native assets exceed 64 MiB at the requested size.
+// Odd heights also catch rounding mismatches that can cause endless redecodes.
+func browserHeavyScene(t *testing.T, s *Server) {
+	t.Helper()
+	var assets []Asset
+	for i := 0; i < 80; i++ {
+		img := image.NewRGBA(image.Rect(0, 0, 512, 509))
+		for y := 0; y < 509; y++ {
+			for x := 0; x < 512; x++ {
+				img.SetRGBA(x, y, color.RGBA{uint8(i + 20), uint8(x * 7), uint8(y * 7), 255})
+			}
+		}
+		var buf bytes.Buffer
+		png.Encode(&buf, img)
+		a, err := prepare(s.root, buf.Bytes(), "token")
+		if err != nil {
+			t.Fatal(err)
+		}
+		assets = append(assets, a)
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	for _, ss := range s.sessions {
+		var scene *Scene
+		for _, candidate := range ss.Scenes {
+			if candidate.Published && len(candidate.Elements) > 0 {
+				scene = candidate
+				break
+			}
+		}
+		if scene == nil {
+			t.Fatal("browser scene with map not found")
+		}
+		floorID := firstFloorID(scene)
+		centerX, centerY := 0.0, 0.0
+		if bounds := scene.Floors[floorID].RenderBounds; bounds != nil {
+			aabb := polygonBounds(*bounds)
+			centerX, centerY = (aabb.MinX+aabb.MaxX)/2, (aabb.MinY+aabb.MaxY)/2
+		} else {
+			initialized := false
+			var minX, minY, maxX, maxY float64
+			for _, element := range scene.Elements {
+				if element.FloorID == floorID {
+					left, top, right, bottom := element.Transform.X, element.Transform.Y, element.Transform.X+element.Transform.Width, element.Transform.Y+element.Transform.Height
+					if !initialized {
+						minX, minY, maxX, maxY, initialized = left, top, right, bottom, true
+					} else {
+						minX, minY = min(minX, left), min(minY, top)
+						maxX, maxY = max(maxX, right), max(maxY, bottom)
+					}
+				}
+			}
+			if initialized {
+				centerX, centerY = (minX+maxX)/2, (minY+maxY)/2
+			}
+		}
+		for i, a := range assets {
+			ss.Assets[a.ID] = a
+			tokenID := id()
+			scene.Tokens[tokenID] = Token{ID: tokenID, Name: "Cache", FloorID: floorID, X: centerX + float64(i%10), Y: centerY + float64(i/10), Size: 1024, Color: "#c2d89b", Asset: a.ID}
+		}
+		scene.Revision++
+		s.dirty = true
+		s.publishSceneSnapshot(ss, scene.ID)
+	}
+}
