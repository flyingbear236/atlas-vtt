+	}
+
+	t.Log("prepare one 10000x10000 tiled asset")
+	imageData := image.NewRGBA(image.Rect(0, 0, 10000, 10000))
+	for y := 0; y < 10000; y++ {
+		for x := 0; x < 10000; x++ {
+			offset := y*imageData.Stride + x*4
+			value := uint8((x*13 + y*7 + (x*y)%251) % 256)
