+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if scene.Revision != revision {
+		t.Fatalf("token asset changed scene revision: %d -> %d", revision, scene.Revision)
+	}
+	if ss.Assets[asset.ID].Kind != "token" {
+		t.Fatal("token asset was not stored at campaign level")
+	}
