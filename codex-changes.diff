+	gc.WriteJSON(Command{Type: "sceneUpdate", SceneID: hidden, Published: func() *bool { v := true; return &v }(), Client: "gm", Seq: 2})
+	read(t, gc, "campaignSnapshot")
+	read(t, gc, "ack")
+	pc.WriteJSON(Command{Type: "subscribe", SceneID: hidden})
+	read(t, pc, "snapshot")
