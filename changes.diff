+	}
+	for _, element := range scene.Elements {
+		if element.FloorID == floorID {
+			return false
+		}
+	}
+	bounds, err := rectanglePolygon(AABB{MaxX: width, MaxY: height})
+	if err != nil {
+		return false
+	}
+	floor.RenderBounds = &bounds
+	floor.GeometryRevision++
+	scene.Floors[floorID] = floor
+	return true
